{
	"$schema": "https://biomejs.dev/schemas/2.3.8/schema.json",
	"root": false,
	"files": {
		"ignoreUnknown": true,
		"includes": ["**", "!dist/**", "!coverage/**"]
	},
	"javascript": {
		"parser": {
			"unsafeParameterDecoratorsEnabled": true
		}
	},
	"linter": {
		"rules": {
			"correctness": {
				"noUnusedPrivateClassMembers": {
					"level": "warn",
					"fix": "none"
				}
			},
			"style": {
				"useImportType": "off"
			}
		}
	},
	"overrides": [
		{
			"includes": ["**/*.spec.ts", "**/*.e2e-spec.ts", "test/**", "**/__tests__/**", "**/__mocks__/**"],
			"linter": {
				"rules": {
					"suspicious": {
						"noExplicitAny": "off"
					},
					"correctness": {
						"noUnusedPrivateClassMembers": "off"
					}
				}
			}
		}
	]
}
